{
  "name": "job-board-server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "concurrently \"nodemon src/server.ts\" \"graphql-codegen --config codegen.json --watch\"",
    "codegen": "graphql-codegen --config codegen.json"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "better-sqlite3": "^12.4.6",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "graphql": "^16.12.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/typescript": "^5.0.5",
    "@graphql-codegen/typescript-resolvers": "^5.1.3",
    "@parcel/watcher": "^2.5.1",
    "@tsconfig/node18": "^18.2.6",
    "@types/cors": "^2.8.19",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "nodemonConfig": {
    "ext": "graphql,ts",
    "execMap": {
      "ts": "tsx"
    }
  }
}
