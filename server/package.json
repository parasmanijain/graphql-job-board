    "knex": "^3.1.0",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3",
    "ts-node": "^10.9.2",
    "@types/node": "^25.3.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/cors": "^2.8.19",
