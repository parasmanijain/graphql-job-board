  "devDependencies": {
    "nodemon": "^3.1.11",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.11.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
